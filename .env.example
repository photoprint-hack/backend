APP_ENV=development
APP_NAME=photoprint
APP_VERSION=1.2.0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/photoprint
# Optional direct/session connection for Alembic, otherwise DATABASE_URL is used.
MIGRATION_DATABASE_URL=
# Generate locally: uv run python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REPORT_TIMEZONE=Europe/Minsk
PORT=8000
METABASE_URL=
METABASE_EMBEDDING_SECRET=
METABASE_DASHBOARD_IDS={}
DEMO_MODE=true
DEMO_REFERENCE_DATE=
DEMO_ADMIN_PASSWORD=
DEMO_DIRECTOR_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_ANALYST_PASSWORD=
DEMO_EMPLOYEE_PASSWORD=
# A dedicated PostgreSQL database; test fixtures create and drop isolated schemas.
TEST_DATABASE_URL=
# Set only after every card has been tested with locked department/date/product filters.
METABASE_VERIFIED_DASHBOARDS=[]
# Impact extension. Only synthetic data may be submitted to the demo AI provider.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_TIMEOUT_SECONDS=30
AI_CACHE_TTL_SECONDS=900
AI_DAILY_BUDGET=40
# Explicit demo exceptions; [] does not mean the official Belarusian holiday calendar was checked.
BUSINESS_HOLIDAYS=[]
WORKER_POLL_SECONDS=10
